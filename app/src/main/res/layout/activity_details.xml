<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textIsSelectable="true" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/details_direction" />
        <TextView android:id="@+id/value_direction"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/details_status" />
        <TextView android:id="@+id/value_status"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/details_size" />
        <TextView android:id="@+id/value_size"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/details_chunks" />
        <TextView android:id="@+id/value_chunks"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/details_recovered" />
        <TextView android:id="@+id/value_recovered"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/details_hash" />
        <TextView android:id="@+id/value_hash"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textIsSelectable="true" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/details_path" />
        <TextView android:id="@+id/value_path"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/details_date" />
        <TextView android:id="@+id/value_date"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/TextAppearance.QRStream.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/details_synced" />
        <TextView android:id="@+id/value_synced"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_no_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/details_no_file"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/action_open_file" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_share"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_verify"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_reverify" />

        <TextView
            android:id="@+id/text_verify_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
